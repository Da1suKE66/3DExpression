{
  "app_version": "0.2.0",
  "schema_version": "2.0.0",
  "protocol_version": "IPP31078-AB90-v2",
  "project_id": "IPP31078",
  "official_title": "基于面部识别跟踪技术探究化身面部表情对于用户具身感的影响",
  "parameters": {
    "duration_ms": 90000,
    "rest_ms": 15000,
    "calibration_ms": 3000,
    "calibration_min_samples": 30,
    "inference_interval_ms": 40,
    "tracking_stale_ms": 400,
    "smoothing_tau_ms": 80,
    "deadzone": 0.015,
    "max_timer_step_ms": 100,
    "max_pixel_ratio": 1.5,
    "gain": {
      "jawOpen": 1,
      "eyeBlinkLeft": 1,
      "eyeBlinkRight": 1,
      "mouthSmileLeft": 1,
      "mouthSmileRight": 1
    },
    "head_tracking": false,
    "show_camera_in_study": false,
    "outside_task_face": "neutral",
    "camera_constraints": {
      "width_ideal": 640,
      "height_ideal": 480,
      "frame_rate_ideal": 30,
      "frame_rate_max": 30,
      "facing_mode": "user"
    },
    "condition_mapping": {
      "A": "static_neutral",
      "B": "live_synchronous"
    },
    "avatar_id": "ipp31078-cartoon-v1",
    "camera_pose": [
      0,
      0.08,
      6.4
    ],
    "background": "#edf2f1"
  },
  "tasks": [
    {
      "id": "jaw",
      "text": "缓慢张嘴，再自然合拢",
      "detail": "约每 5 秒重复一次，保持头部自然稳定",
      "duration_ms": 20000
    },
    {
      "id": "blink",
      "text": "自然眨眼，间或缓慢闭眼",
      "detail": "约每 5 秒缓慢闭眼一次，避免用力挤眼",
      "duration_ms": 20000
    },
    {
      "id": "smile",
      "text": "轻轻微笑，再放松面部",
      "detail": "约每 5 秒重复一次，幅度以舒适为准",
      "duration_ms": 20000
    },
    {
      "id": "free",
      "text": "自由组合刚才的面部动作",
      "detail": "尝试张嘴、眨眼和微笑，注视同一个化身",
      "duration_ms": 30000
    }
  ],
  "coefficients": [
    "jawOpen",
    "eyeBlinkLeft",
    "eyeBlinkRight",
    "mouthSmileLeft",
    "mouthSmileRight"
  ],
  "questions": [
    {
      "id": "control",
      "label": "面部控制感",
      "text": "我感觉自己能够控制化身的面部动作。"
    },
    {
      "id": "congruence",
      "label": "动作一致性",
      "text": "化身的面部动作与我做出的动作一致。"
    },
    {
      "id": "identification",
      "label": "化身认同",
      "text": "体验时，我对这个化身有认同感。"
    },
    {
      "id": "naturalness",
      "label": "自然程度",
      "text": "化身的面部表现让我感觉自然。"
    }
  ]
}
